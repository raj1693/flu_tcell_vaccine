\f0\fs24 \cf0 library(ggplot2)\
library(tidyverse)\
library(readxl)\
\
# Read the Excel data\
data <- read_excel("/Users/raj/Desktop/R scripts for the bioinfo analysis/NP_M1_iedb.xlsx")\
\
# Remove rows with missing values\
data_cleaned <- data %>%\
    filter(across(everything(), ~ !is.na(.)))\
\
# Reorder the facet column\
data$facet_column <- factor(data$facet_column, levels = c("NP H1N1", "M1 H1N1", "NP H3N2", "M1 H3N2"))\
\
# Create the faceted dot plot\
ggplot(data, aes(x = `Amino acid position`, y = `Percentile Rank`, color = `MHC allele`, shape = Host)) +\
    geom_point(aes(shape = Host), size = 2, stroke = 0.5) +\
    facet_wrap(~ facet_column, ncol = 2, scales = "free_x") +\
    labs(x = "Amino acid position", y = "Percentile Rank") +\
    scale_shape_manual(values = c(16, 17)) +  # 16: circle, 17: triangle\
    scale_y_reverse() +  # Invert the y-axis\
    theme_minimal() +\
    theme(panel.background = element_rect(fill = "white"),\
          panel.border = element_rect(color = "black", fill = NA),\
          strip.background = element_rect(fill = "lightblue"),\
          strip.text = element_text(color = "black"))}